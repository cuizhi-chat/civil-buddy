# copy to demo/.env — never commit secrets
# Any OpenAI-compatible Chat Completions key. DeepSeek is optional.

# CIVIL_API_KEY=
# CIVIL_API_BASE=https://api.openai.com/v1
# CIVIL_MODEL=gpt-4o-mini

# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# CIVIL_PORT=8765
# CIVIL_JOB_ROOT=

# packing-agent sidecar (pick one)
# PACKING_AGENT_URL=http://127.0.0.1:8000
# PACKING_AGENT_ROOT=E:\ai比赛

# --- 手机 / 局域网访问（可选） ---
# 0.0.0.0 让同一 Wi-Fi 下的手机打开 http://<本机IP>:8765；无鉴权，只在可信内网开
# CIVIL_HOST=127.0.0.1
# CIVIL_PORT=8765
# 模型没吐字时 SSE 心跳间隔（秒），代理/手机网络不会把空闲连接切掉
# CIVIL_SSE_PING_SEC=15
# 上游模型两段输出之间最长等多久（秒）
# CIVIL_LLM_READ_TIMEOUT=180
# 同时进行的对话数上限（每个占一条工作线程）
# CIVIL_MAX_CHATS=8
